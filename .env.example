# ===========================================
# Intent System - Environment Template
# Copy this to .env and fill in your values
# ===========================================

# ----- Server (intent-api) -----
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=debug

# ----- Base Sepolia (EVM) -----
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_SEPOLIA_GATEWAY=0xEC4c2DaEfeA63A15427c73976eaBAB945B76b463
BASE_SEPOLIA_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# ----- Solver -----
RPC_URL=https://sepolia.base.org
GATEWAY_ADDRESS=0xEC4c2DaEfeA63A15427c73976eaBAB945B76b463
SOLVER_PRIVATE_KEY=0x_YOUR_SOLVER_PRIVATE_KEY_HERE
MIN_PROFIT_BPS=50
POLL_INTERVAL_SECS=5

# ----- Database -----
DATABASE_URL=postgresql://user:password@localhost:5432/intent_db
